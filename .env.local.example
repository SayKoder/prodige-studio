# ─── Base de données ──────────────────────────────────────────────────────────
# Développement local (correspond à docker-compose.dev.yml)
DATABASE_URL="postgresql://prodige:devpassword@localhost:5432/prodige_dev"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="REMPLACER_PAR_UN_SECRET_ALEATOIRE"
NEXTAUTH_URL="http://localhost:3000"

# ─── Admin (optionnel, utilisé par prisma/seed.ts) ───────────────────────────
# Si non défini : admin@prodige-studio.me / Prodige@Studio24!
# ADMIN_EMAIL="admin@prodige-studio.me"
# ADMIN_PASSWORD="VotreMotDePasseSecurisé"

# ─── Formulaire de contact (Resend) ───────────────────────────────────────────
# Créer un compte sur resend.com, vérifier un domaine d'envoi, puis générer une clé API.
# Sans cette clé, les demandes restent enregistrées en base mais aucun e-mail n'est envoyé.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# CONTACT_EMAIL_FROM="Prodige Studio <contact@prodige-studio.me>"
# CONTACT_EMAIL_TO="carl.heintz02@gmail.com"

# ─── Avis Google (Places API New) ─────────────────────────────────────────────
# 1. Créer un projet sur console.cloud.google.com et activer "Places API (New)".
# 2. Générer une clé API restreinte par IP serveur (pas par référent HTTP).
# 3. Trouver le Place ID du studio via "Place ID Finder" (Google Maps Platform).
# Sans ces deux valeurs, la section avis affiche le dernier instantané en cache.
# GOOGLE_PLACES_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# GOOGLE_PLACE_ID="ChIJxxxxxxxxxxxxxxxxxxxxxxx"
